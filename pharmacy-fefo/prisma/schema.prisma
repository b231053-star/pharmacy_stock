generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Medicine {
  id               String   @id @default(uuid())
  name             String   @unique
  category         String   @default("General")
  reorderThreshold Int      @default(20)
  createdAt        DateTime @default(now())
  batches          Batch[]
}

model Batch {
  id          String   @id @default(uuid())
  batchNumber String
  quantity    Int
  expiryDate  DateTime
  status      String   @default("ACTIVE") // ACTIVE, EXPIRING_SOON, QUARANTINED
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([medicineId, batchNumber])
}

model Outbox {
  id         String   @id @default(uuid())
  type       String   // REORDER_ALERT
  medicineId String
  payload    String   // JSON string
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}
